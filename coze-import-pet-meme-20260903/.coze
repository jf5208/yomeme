[project]
sub_id = "29b6feda"
name = "pet-meme-generator"
project_type = "web"
entrypoint = "run.py"
requires = ["python-3.11"]

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/run.sh"]

[deploy]
build = ["bash", "scripts/setup.sh"]
run = ["bash", "scripts/http_run.sh", "-p", "5000"]

[deploy.profile]
kind = "service"
flavor = "web"
