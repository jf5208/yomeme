<view class="page">
  <view class="topbar">
    <view>
      <text class="brand">YoMeme</text>
      <text class="tagline">把表情包换成我家毛孩子</text>
    </view>
    <navigator class="credits-link" url="/pages/credits/index">积分</navigator>
  </view>

  <view class="section reference-section">
    <text class="section-title">选这种模板，生成效果更稳定</text>
    <view class="reference-grid">
      <view class="reference-item">
        <image class="reference-image" src="/assets/reference/front-head.jpg" mode="aspectFill" />
        <text>正脸大头，神态清楚</text>
      </view>
      <view class="reference-item">
        <image class="reference-image" src="/assets/reference/half-body.jpg" mode="aspectFill" />
        <text>半身入镜，背景简单</text>
      </view>
    </view>
    <text class="reference-note">正方形、单只动物、主体清楚、背景简单</text>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-title">1. 选择 Meme 模板</text>
      <text class="required-note">仅支持 1:1 正方形模板</text>
    </view>
    <view class="upload-box template-upload" bindtap="chooseTemplate">
      <image wx:if="{{template}}" class="template-preview" src="{{template.path}}" mode="aspectFill" />
      <view wx:else class="upload-placeholder">
        <text class="upload-symbol">＋</text>
        <text>选择一张模板</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-title">2. 上传自家宠物照片</text>
      <text class="required-note">1–3 张，同一只宠物</text>
    </view>
    <view class="pets-upload">
      <view class="pet-item" wx:for="{{pets}}" wx:key="path">
        <image class="pet-preview" src="{{item.path}}" mode="aspectFill" />
        <button class="remove-button" data-index="{{index}}" bindtap="removePet" aria-label="删除这张照片">×</button>
      </view>
      <button wx:if="{{pets.length < 3}}" class="add-pet-button" bindtap="choosePets">
        <text class="upload-symbol">＋</text>
        <text>添加照片</text>
      </button>
    </view>
    <text class="pet-note">建议至少有一张清晰正脸照</text>
  </view>

  <checkbox-group class="rights-row" bindchange="toggleRights">
    <label>
      <checkbox value="confirmed" checked="{{rightsConfirmed}}" color="#d96b5b" />
      <text>我确认素材为本人创作、本人拍摄或已获授权</text>
    </label>
  </checkbox-group>

  <button
    class="generate-button"
    bindtap="submitGeneration"
    loading="{{submitting}}"
    disabled="{{!template || pets.length === 0 || !rightsConfirmed || submitting}}"
  >{{submitting ? "正在准备…" : "生成我家版本"}}</button>
  <text wx:if="{{submitting}}" class="progress-text">图片上传 {{uploadProgress}}%</text>
</view>
